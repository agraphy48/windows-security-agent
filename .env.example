# ==============================================================
# WINDOWS SECURITY AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================

# Nomor WhatsApp Admin (Gunakan kode negara, tanpa '+' atau tanda spasi)
# Contoh: 6281234567890
# Bisa diisi lebih dari satu nomor dipisahkan tanda koma
# Jika dikosongkan, nomor pertama yang scan/chat bot akan otomatis menjadi admin utama.
ADMIN_NUMBERS=

# Port web dashboard lokal untuk scan QR Code di browser
QR_PORT=5005

# Interval sensor pemantau keamanan latar belakang (dalam detik)
WATCHER_INTERVAL_SECONDS=30

# URL dan Model Ollama Lokal (Opsional, untuk respons chat AI)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Konfigurasi Cloudflare Tunnel (Opsional, untuk fitur !lockdown & !restore)
# CLOUDFLARE_EXE=C:\Tools\cloudflared.exe
# CLOUDFLARE_ARGS=tunnel run <tunnel-id>
