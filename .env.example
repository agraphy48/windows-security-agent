# ==============================================================
# WINDOWS / LINUX SECURITY AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================

# Nomor WhatsApp Admin (Gunakan kode negara, tanpa '+' atau tanda spasi)
# Contoh: 6281234567890
# Bisa diisi lebih dari satu nomor dipisahkan tanda koma
# Jika dikosongkan, nomor pertama yang scan/chat bot akan otomatis menjadi admin utama.
ADMIN_NUMBERS=

# Port web dashboard lokal untuk scan QR Code di browser
QR_PORT=5005

# Interval sensor pemantau keamanan latar belakang (dalam detik)
WATCHER_INTERVAL_SECONDS=30

# URL dan Model Ollama Lokal (Opsional, untuk respons chat AI)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# ==============================================================
# FITUR KEAMANAN PIN & INTRUDER ALERT
# ==============================================================
# PIN Keamanan untuk membuka bot & perintah (Ganti dengan 4-6 digit angka Anda)
SECURITY_PIN=1234
REQUIRE_PIN=true

# Kunci SEMUA perintah dengan PIN (Bot selalu terkunci sebelum memasukkan PIN)
REQUIRE_PIN_ALL=true

# Durasi sesi terbuka setelah memasukkan PIN (dalam menit)
# Set ke 0 jika ingin setiap perintah harus menyertakan PIN
PIN_TIMEOUT_MINUTES=15

# Aktifkan notifikasi jika nomor asing mencoba menghubungi bot
INTRUDER_ALERT=true

# ==============================================================
# KONFIGURASI MULTI-SERVER CLUSTER & FAILOVER (HA)
# ==============================================================
# Peran Node ini: 'master' (koordinator) | 'standby' (backup) | 'worker' (node biasa)
CLUSTER_ROLE=master
NODE_ID=node-01
NODE_NAME=Server Utama

# Port komunikasi antar server (cluster)
CLUSTER_PORT=5005

# Token rahasia otentikasi antar server (wajib sama di semua node cluster)
CLUSTER_SECRET=secops-cluster-token-secret-2026

# URL Master (Diisi pada node standby / worker untuk menghubungi Master)
MASTER_URL=http://127.0.0.1:5005

# Waktu batas Master tidak merespons sebelum Standby mengambil alih (dalam detik)
FAILOVER_TIMEOUT_SECONDS=30

# Konfigurasi Cloudflare Tunnel (Opsional, untuk fitur !lockdown & !restore)
# CLOUDFLARE_EXE=C:\Tools\cloudflared.exe
# CLOUDFLARE_ARGS=tunnel run <tunnel-id>
